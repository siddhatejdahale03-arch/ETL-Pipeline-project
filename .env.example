# Copy this file to .env and fill in your values:   cp .env.example .env

# ── Demo mode ───────────────────────────────────────────────────────────────
# true  = use fake data from data/sample/ (no API keys needed)
# false = call the real Stripe + Salesforce APIs
DEMO_MODE=true

# ── Stripe (Siddhatej) ──────────────────────────────────────────────────────
STRIPE_API_KEY=sk_test_your_key_here
STRIPE_PAGE_LIMIT=100

# ── Salesforce (Siddhatej) ──────────────────────────────────────────────────
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_API_VERSION=v59.0

# ── AWS S3 raw data lake (Siddhatej) ────────────────────────────────────────
# false = save raw JSON to data/raw/ on your computer instead of S3
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=etl-raw-data

# ── Data Warehouse (Rohan) ──────────────────────────────────────────────────
# Port 5433 = the Postgres started by docker-compose
DW_CONNECTION_STRING=postgresql+psycopg2://etl:etl@localhost:5433/dw

# ── Alerts (Sumit) ──────────────────────────────────────────────────────────
# Optional — leave empty if you do not use Slack
SLACK_WEBHOOK_URL=
# Who receives failure alerts
ALERT_EMAIL=you@example.com
# Gmail account that SENDS the alerts. SMTP_PASSWORD must be a Gmail App Password:
# https://myaccount.google.com/apppasswords  (needs 2-Step Verification turned on)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=

# ── General ─────────────────────────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
LOG_LEVEL=INFO
