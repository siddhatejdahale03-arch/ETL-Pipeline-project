# ── Required ────────────────────────────────────────────────────────────────

# Stripe API secret key (get from https://dashboard.stripe.com/apikeys)
STRIPE_API_KEY=sk_live_your_key_here

# Records per Stripe API page (1-100, default: 100)
STRIPE_PAGE_LIMIT=100

# ── AWS S3 — Raw Data Lake ───────────────────────────────────────────────────

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-etl-raw-bucket

# Top-level S3 prefix (default: raw)
S3_RAW_PREFIX=raw

# ── Salesforce (optional — Week 2+) ─────────────────────────────────────────

SALESFORCE_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=

# ── Pipeline Behaviour ───────────────────────────────────────────────────────

# Retry attempts for API calls (default: 3)
MAX_RETRY_ATTEMPTS=3

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
